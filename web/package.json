{
  "name": "mathbot-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -H 0.0.0.0",
    "dev:webpack": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run test:dependencies",
    "test": "jest",
    "test:dependencies": "node --test tools/dependency-compat.test.cjs",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.78.0",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "mathlive": "^0.110.0",
    "next": "^15.5.28",
    "next-auth": "^4.24.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-easy-crop": "^5.0.5",
    "react-hot-toast": "^2.6.0",
    "react-qr-code": "^2.0.18",
    "recharts": "^3.7.0",
    "typescript": "5.6.3"
  },
  "devDependencies": {
    "minimatch": "file:tools/minimatch-compat",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^30.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.28",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19"
  },
  "overrides": {
    "postcss": "$postcss",
    "uuid": "11.1.1",
    "sharp": "0.35.5",
    "minimatch@<9": "$minimatch",
    "minimatch@>=9": "11.0.3",
    "glob@>=9": "14.0.3",
    "flat-cache@3": {
      "rimraf": "6.1.3"
    }
  }
}
