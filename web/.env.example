NEXT_PUBLIC_API_URL=/api/backend
BACKEND_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INTERNAL_PROXY_SHARED_SECRET=

# Self-hosted only: set to x-real-ip ONLY behind an ingress that overwrites it
# and prevents direct access to Next.js. Vercel uses its owned header by default.
# Unset/invalid IP uses a shared, bounded quiz-entry bucket.
TRUSTED_CLIENT_IP_HEADER=

# Vercel: polling. VPS with a WebSocket server: websocket and its HTTPS URL.
NEXT_PUBLIC_REALTIME_TRANSPORT=websocket
NEXT_PUBLIC_WS_API_URL=
CSP_CONNECT_SRC=
