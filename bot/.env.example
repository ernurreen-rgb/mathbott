# PostgreSQL is required. Local Docker (docker-compose.dev.yml):
#   postgresql://postgres:postgres@127.0.0.1:5432/qazmath
# Neon runtime: use the pooled URL; require TLS in hosted environments.
DATABASE_URL=
# Neon migrations: use the direct URL to the SAME database and branch (optional locally).
DATABASE_MIGRATION_URL=
# Tests read TEST_DATABASE_URL from the shell, never from this file (see docs/development/setup.md).

ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INTERNAL_PROXY_SHARED_SECRET=
ADMIN_EMAIL=

# Shared network quotas for quiz PIN lookups/joins, sized for classroom NATs.
QUIZ_ENTRY_REQUESTS_PER_MINUTE=1200
QUIZ_ENTRY_DISTINCT_PINS_PER_MINUTE=30
QUIZ_ENTRY_NEW_PARTICIPANTS_PER_MINUTE=300
QUIZ_MAX_PARTICIPANTS=500

# Vercel automatically disables background loops. Cron calls /api/maintenance.
CRON_SECRET=

# local for development; s3 for Vercel (Neon Object Storage, R2, AWS S3, etc.).
IMAGE_STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI twin drafts: any OpenAI-compatible Chat Completions API (OpenAI, Gemini,
# DeepSeek, OpenRouter, ...). The feature stays off until all three are set.
# Example base URL: https://api.openai.com/v1
AI_TWIN_BASE_URL=
AI_TWIN_API_KEY=
AI_TWIN_MODEL=
